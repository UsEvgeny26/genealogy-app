# Нормализуем все текстовые файлы в репозитории в LF
* text=auto eol=lf

# Явно помечаем бинарники
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Windows-скрипты оставляем с CRLF (если они есть)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf